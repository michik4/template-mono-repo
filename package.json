{
    "name": "mono-repo-template",
    "description": "Modern fullstack monorepo template",
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "snapshot": "bun ./.dev/scripts/snapshot.ts",
        "snapshot:code": "bun ./.dev/scripts/snapshot.ts code",
        "utils:printall": "bun ./.dev/utils/printall.ts"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "devDependencies": {
        "@types/bun": "^1.4.2",
        "@types/node": "^26.6.2",
        "turbo": "^2.11.2"
    },
    "engines": {
        "node": ">=26.0.0"
    },
    "packageManager": "bun@1.4.0",
    "devEngines": {
        "runtime": {
            "name": "bun",
            "version": "^1.4.0",
            "onFail": "error"
        },
        "packageManager": {
            "name": "bun",
            "version": "^1.4.0",
            "onFail": "error"
        }
    }
}