{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "types": ["bun", "node"],
  },
  "include": [
    ".dev/**/*.ts",
    "*.ts",
    "*.mjs"
  ],
  "exclude": [
    "node_modules",
    "apps",
    "packages"
  ]
}